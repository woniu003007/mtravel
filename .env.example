# 本文件只放示例值，不写真实密码。
# 使用方式：
#   cp .env.example .env.local
#   修改 .env.local 里的密码
#   ./start-backend.sh

SERVER_PORT=8080

DB_HOST=
DB_PORT=5432
DB_NAME=mtravel
DB_USER=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

FLYWAY_ENABLED=false

# 景区资料 OCR。真实 AccessKey 只写入 .env.local 或部署环境变量。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# 景区资料向量化。Key 也可由系统配置按租户维护。
BAILIAN_API_KEY=
BAILIAN_EMBEDDING_MODEL=text-embedding-v4

# 客服 Agent 后端认证。真实 Token 只写入 .env.local。
AGENT_SERVICE_TOKEN=
AGENT_SERVICE_TOKEN_TENANT_ID=1

# 客服 Agent Python 服务。默认 mock，避免本地演示创建真实业务待办。
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
DMS_BASE_URL=http://127.0.0.1:8080
DMS_SERVICE_TOKEN=
DMS_MOCK_MODE=true
AGENT_HOST=127.0.0.1
AGENT_PORT=5670
